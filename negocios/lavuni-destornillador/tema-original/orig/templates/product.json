        "custom_liquid": "<div class=\"trustbar\">\n\n  <div class=\"trust-item\">\n    <h3>{{ 'lavuni_custom.text_126' | t }}</h3>\n    <p>{{ 'lavuni_custom.text_127' | t }}</p>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <div class=\"trust-item\">\n    <h3>{{ 'lavuni_custom.text_128' | t }}</h3>\n    <p>{{ 'lavuni_custom.text_129' | t }}</p>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <div class=\"trust-item\">\n    <h3>{{ 'lavuni_custom.text_130' | t }}</h3>\n    <p>{{ 'lavuni_custom.text_131' | t }}</p>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <div class=\"trust-item\">\n    <h3>{{ 'lavuni_custom.text_132' | t }}</h3>\n    <p>{{ 'lavuni_custom.text_133' | t }}</p>\n  </div>\n\n</div>\n\n<style>\n.trustbar {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 3rem;\n  background: #f7d7dc;\n  padding: 2.5rem 2rem;\n  text-align: center;\n  font-family: \"Poppins\", sans-serif;\n  color: #2E2A39;\n  flex-wrap: wrap;\n}\n\n.trust-item {\n  max-width: 260px;\n}\n\n.trust-item h3 {\n  font-size: 1.25rem;\n  font-weight: 700;\n  letter-spacing: 0.8px;\n  margin-bottom: 0.4rem;\n}\n\n.trust-item p {\n  font-size: 1rem;\n  color: #333;\n  margin: 0;\n  line-height: 1.5;\n}\n\n.divider {\n  width: 1.5px;\n  height: 50px;\n  background: rgba(0,0,0,0.25);\n}\n\n@media (max-width: 768px) {\n  .trustbar {\n    flex-direction: column;\n    gap: 1.5rem;\n  }\n\n  .divider {\n    display: none;\n  }\n\n  .trust-item h3 {\n    font-size: 1.1rem;\n  }\n\n  .trust-item p {\n    font-size: 0.9rem;\n  }\n}\n</style>",
