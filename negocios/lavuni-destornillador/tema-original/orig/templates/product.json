        "custom_liquid": "<style>\n  .lavuni-faq {\n    width: 100%;\n    background: #F7D7FC;\n    padding: 60px 20px 70px;\n    box-sizing: border-box;\n  }\n\n  .lavuni-faq-container {\n    max-width: 1050px;\n    margin: 0 auto;\n  }\n\n  .lavuni-faq-title {\n    text-align: center;\n    margin: 0 0 38px;\n    color: #292d42;\n    font-size: 40px;\n    line-height: 1.2;\n    font-weight: 700;\n    letter-spacing: -0.5px;\n  }\n\n  .lavuni-faq-item {\n    border-top: 1px solid rgba(41, 45, 66, 0.12);\n  }\n\n  .lavuni-faq-item:last-child {\n    border-bottom: 1px solid rgba(41, 45, 66, 0.12);\n  }\n\n  .lavuni-faq-question {\n    width: 100%;\n    border: 0;\n    background: transparent;\n    padding: 24px 8px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 20px;\n    cursor: pointer;\n    text-align: left;\n    color: #292d42;\n    font-size: 18px;\n    line-height: 1.4;\n    font-weight: 700;\n    font-family: inherit;\n  }\n\n  .lavuni-faq-question:hover {\n    opacity: 0.75;\n  }\n\n  .lavuni-faq-arrow {\n    width: 9px;\n    height: 9px;\n    border-right: 1.8px solid #292d42;\n    border-bottom: 1.8px solid #292d42;\n    transform: rotate(45deg);\n    transition: transform 0.3s ease;\n    flex-shrink: 0;\n    margin-right: 4px;\n  }\n\n  .lavuni-faq-item.active .lavuni-faq-arrow {\n    transform: rotate(225deg);\n  }\n\n  .lavuni-faq-answer {\n    max-height: 0;\n    overflow: hidden;\n    opacity: 0;\n    transition:\n      max-height 0.4s ease,\n      opacity 0.3s ease,\n      padding 0.4s ease;\n    padding: 0 8px;\n  }\n\n  .lavuni-faq-item.active .lavuni-faq-answer {\n    max-height: 350px;\n    opacity: 1;\n    padding: 0 8px 26px;\n  }\n\n  .lavuni-faq-answer p {\n    margin: 0;\n    max-width: 940px;\n    color: #555765;\n    font-size: 17px;\n    line-height: 1.7;\n    font-weight: 400;\n  }\n\n  .lavuni-faq-answer strong {\n    color: #292d42;\n    font-weight: 700;\n  }\n\n  @media screen and (max-wid