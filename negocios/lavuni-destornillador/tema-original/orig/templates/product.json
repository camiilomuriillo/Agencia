        "custom_liquid": "<style>\n  .lavuni-howto {\n    width: 100%;\n    background: #ffffff;\n    padding: 55px 20px 65px;\n    box-sizing: border-box;\n  }\n\n  .lavuni-howto-container {\n    max-width: 1250px;\n    margin: 0 auto;\n  }\n\n  /* MAIN TITLE */\n  .lavuni-howto-title {\n    text-align: center;\n    margin: 0 0 48px;\n    color: #292d42;\n    font-size: 32px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: -0.5px;\n  }\n\n  /* 3-STEP GRID */\n  .lavuni-howto-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 55px;\n    align-items: start;\n  }\n\n  .lavuni-howto-step {\n    text-align: center;\n  }\n\n  /* CIRCULAR IMAGE */\n  .lavuni-howto-image-wrapper {\n    width: 100%;\n    max-width: 330px;\n    aspect-ratio: 1 / 1;\n    margin: 0 auto 28px;\n    border-radius: 50%;\n    overflow: hidden;\n    background: #f7edf5;\n  }\n\n  .lavuni-howto-image {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  /* STEP TITLES */\n  .lavuni-howto-step-title {\n    color: #292d42;\n    font-size: 23px;\n    line-height: 1.25;\n    font-weight: 800;\n    margin: 0 0 17px;\n  }\n\n  /* TEXT */\n  .lavuni-howto-text {\n    max-width: 350px;\n    margin: 0 auto;\n    color: #555765;\n    font-size: 17px;\n    line-height: 1.75;\n    font-weight: 400;\n  }\n\n  .lavuni-howto-text strong {\n    color: #292d42;\n    font-weight: 700;\n  }\n\n  /* TABLET */\n  @media screen and (max-width: 990px) {\n    .lavuni-howto {\n      padding: 45px 24px 55px;\n    }\n\n    .lavuni-howto-grid {\n      gap: 30px;\n    }\n\n    .lavuni-howto-title {\n      font-size: 28px;\n      margin-bottom: 40px;\n    }\n\n    .lavuni-howto-image-wrapper {\n      max-width: 260px;\n    }\n\n    .lavuni-howto-step-title {\n      font-size: 20px;\n    }\n\n    .lavuni-howto-text {\n      font-size: 15.5px;\n      line-height: 1.65;\n    }\n  }\n\n  /* MOBILE */\n  @media screen and (max-width: 749px) {\n    .lavuni-howto {\n      padding: 38px 20px 50px;\n    }\n\n    .lavuni-howto-title {\n      font-size: 25px;\n      line-height: 1.25;\n      margin-bottom: 38px;\n    }\n\n    .lavuni-howto-grid {\n      grid-template-columns: 1fr;\n      gap: 48px;\n    }\n\n    .lavuni-howto-image-wrapper {\n      width: min(82vw, 310px);\n      max-width: none;\n      margin-bottom: 23px;\n    }\n\n    .lavuni-howto-step-title {\n      font-size: 21px;\n      margin-bottom: 13px;\n    }\n\n    .lavuni-howto-text {\n      max-width: 340px;\n      font-size: 16px;\n      line-height: 1.7;\n    }\n  }\n</style>\n\n\n<section class=\"lavuni-howto\">\n  <div class=\"lavuni-howto-container\">\n\n    <h2 class=\"lavuni-howto-title\">\n      {{ 'lavuni_custom.text_107' | t }}\n    </h2>\n\n    <div class=\"lavuni-howto-grid\">\n\n      <!-- STEP 1 -->\n      <div class=\"lavuni-howto-step\">\n\n        <div class=\"lavuni-howto-image-wrapper\">\n          <img\n            class=\"lavuni-howto-image\"\n            src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/foto_paso_1.png?v=1789693570\"\n            alt=\"{{ 'lavuni_custom.image_2' | t | escape }}\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <h3 class=\"lavuni-howto-step-title\">\n          {{ 'lavuni_custom.text_108' | t }}\n        </h3>\n\n        <p class=\"lavuni-howto-text\">\n          {{ 'lavuni_custom.text_109' | t }} <strong>{{ 'lavuni_custom.text_110' | t }}</strong>{{ 'lavuni_custom.text_111' | t }} <strong>{{ 'lavuni_custom.text_112' | t }}</strong> {{ 'lavuni_custom.text_113' | t }}\n        </p>\n\n      </div>\n\n\n      <!-- STEP 2 -->\n      <div class=\"lavuni-howto-step\">\n\n        <div class=\"lavuni-howto-image-wrapper\">\n          <img\n            class=\"lavuni-howto-image\"\n            src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/paso_2.png?v=1789693589\"\n            alt=\"{{ 'lavuni_custom.image_3' | t | escape }}\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <h3 class=\"lavuni-howto-step-title\">\n          {{ 'lavuni_custom.text_114' | t }}\n        </h3>\n\n        <p class=\"lavuni-howto-text\">\n          {{ 'lavuni_custom.text_115' | t }} <strong>{{ 'lavuni_custom.text_116' | t }}</strong> {{ 'lavuni_custom.text_117' | t }}\n          <strong>{{ 'lavuni_custom.text_118' | t }}</strong>{{ 'lavuni_custom.text_119' | t }}\n        </p>\n\n      </div>\n\n\n      <!-- STEP 3 -->\n      <div class=\"lavuni-howto-step\">\n\n        <div class=\"lavuni-howto-image-wrapper\">\n          <img\n            class=\"lavuni-howto-image\"\n            src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/paso_3.png?v=1789693615\"\n            alt=\"{{ 'lavuni_custom.image_4' | t | escape }}\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <h3 class=\"lavuni-howto-step-title\">\n          {{ 'lavuni_custom.text_120' | t }}\n        </h3>\n\n        <p class=\"lavuni-howto-text\">\n          {{ 'lavuni_custom.text_121' | t }} <strong>{{ 'lavuni_custom.text_122' | t }}</strong> {{ 'lavuni_custom.text_123' | t }}\n          <strong>{{ 'lavuni_custom.text_124' | t }}</strong> {{ 'lavuni_custom.text_125' | t }}\n        </p>\n\n      </div>\n\n    </div>\n  </div>\n</section>",
