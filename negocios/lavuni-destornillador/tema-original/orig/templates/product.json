    "custom_liquid_d7zFcP": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"comparison-section\">\n\n  <div class=\"text-side\">\n    <h2>{{ 'lavuni_custom.text_134' | t }}</h2>\n\n    <p>\n      {{ 'lavuni_custom.text_135' | t }}\n    </p>\n  </div>\n\n  <div class=\"image-side\">\n    <div class=\"compare-wrapper\" id=\"compareWrapper\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/despues.png?v=1789685859\"\n        class=\"before\"\n        id=\"beforeImg\"\n        alt=\"{{ 'lavuni_custom.image_4' | t | escape }}\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/antes.png?v=1789685879\"\n        class=\"after\"\n        id=\"afterImg\"\n        alt=\"{{ 'lavuni_custom.image_5' | t | escape }}\"\n      >\n\n      <div class=\"divider\" id=\"divider\">\n        <span>{{ 'lavuni_custom.text_136' | t }}</span>\n      </div>\n\n      <!-- Labels -->\n      <div class=\"corner-label left\">{{ 'lavuni_custom.text_137' | t }}</div>\n      <div class=\"corner-label right\">{{ 'lavuni_custom.text_138' | t }}</div>\n\n    </div>\n  </div>\n\n</div>\n\n<style>\n\n.comparison-section {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 3rem;\n  padding: 5rem 2rem;\n  background: #fff;\n  font-family: \"Poppins\", sans-serif;\n  color: #2E2A39;\n}\n\n.text-side {\n  flex: 1;\n  max-width: 520px;\n}\n\n.text-side h2 {\n  font-size: 2.6rem;\n  font-weight: 700;\n  line-height: 1.2;\n  margin-bottom: 1rem;\n}\n\n.text-side p {\n  font-size: 1.5rem;\n  line-height: 1.8;\n  color: #444;\n}\n\n.image-side {\n  flex: 1;\n  max-width: 520px;\n  display: flex;\n  justify-content: center;\n  width: 100%;\n}\n\n\n/* --- COMPARISON SLIDER --- */\n\n.compare-wrapper {\n  position: relative;\n  width: 100%;\n  max-width: 520px;\n  aspect-ratio: 3/4;\n  overflow: hidden;\n  border-radius: 16px;\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);\n  cursor: ew-resize;\n  user-select: none;\n  touch-action: none;\n  background: #f8f8f8;\n}\n\n.compare-wrapper img {\n  position: absolute;\n  top: 0;\n  left: 0;\n  height: 100%;\n  width: 100%;\n  object-fit: cover;\n  pointer-events: none;\n  display: block;\n}\n\n.compare-wrapper img.before {\n  clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);\n}\n\n.compare-wrapper img.after {\n  clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);\n}\n\n.divider {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  width: 2px;\n  height: 100%;\n  background: #E65286;\n  transform: translateX(-1px);\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  pointer-events: none;\n}\n\n.divider span {\n  position: absolute;\n  bottom: 6%;\n  left: 50%;\n  transform: translate(-50%, 0);\n  background: #fff;\n  border: 2px solid #E65286;\n  color: #E65286;\n  font-weight: 600;\n  font-size: 0.85rem;\n  border-radius: 999px;\n  padding: 6px 16px;\n  white-space: nowrap;\n  box-shadow: 0 0 6px rgba(0,0,0,0.2);\n}\n\n\n/* Corner labels */\n\n.corner-label {\n  position: absolute;\n  top: 12px;\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: #fff;\n  background: rgba(0,0,0,0.4);\n  padding: 4px 12px;\n  border-radius: 6px;\n  backdrop-filter: blur(2px);\n  pointer-events: none;\n  user-select: none;\n}\n\n.corner-label.left {\n  left: 12px;\n}\n\n.corner-label.right {\n  right: 12px;\n}\n\n\n/* --- RESPONSIVE --- */\n\n@media (max-width: 900px) {\n\n  .comparison-section {\n    flex-direction: column;\n    text-align: center;\n    padding: 3rem 1.5rem;\n    gap: 2rem;\n  }\n\n  .text-side h2 {\n    font-size: 1.9rem;\n  }\n\n  .text-side p {\n    font-size: 1.2rem;\n  }\n\n  .image-side {\n    max-width: 100%;\n    width: 100%;\n  }\n\n  .divider span {\n    font-size: 0.75rem;\n    padding: 4px 12px;\n    bottom: 4%;\n  }\n\n}\n\n</style>\n\n<script>\n\nconst wrapper = document.getElementById('compareWrapper');\nconst after = document.getElementById('afterImg');\nconst before = document.getElementById('beforeImg');\nconst divider = document.getElementById('divider');\n\nlet isDown = false;\nlet userInteracted = false;\n\n\nfunction moveSlider(x) {\n\n  const rect = wrapper.getBoundingClientRect();\n\n  let offset = x - rect.left;\n\n  offset = Math.max(0, Math.min(offset, rect.width));\n\n  const percent = (offset / rect.width) * 100;\n\n  after.style.clipPath =\n    `polygon(0 0, ${percent}% 0, ${percent}% 100%, 0 100%)`;\n\n  before.style.clipPath =\n    `polygon(${percent}% 0, 100% 0, 100% 100%, ${percent}% 100%)`;\n\n  divider.style.left = `${percent}%`;\n}\n\n\nfunction stopIdle() {\n\n  if (!userInteracted) {\n    userInteracted = true;\n  }\n\n}\n\n\n/* Desktop */\n\nwrapper.addEventListener('mousedown', e => {\n  isDown = true;\n  stopIdle();\n  moveSlider(e.clientX);\n});\n\nwrapper.addEventListener('mousemove', e => {\n  if (isDown) moveSlider(e.clientX);\n});\n\nwindow.addEventListener('mouseup', () => {\n  isDown = false;\n});\n\n\n/* Mobile */\n\nwrapper.addEventListener('touchstart', e => {\n\n  isDown = true;\n\n  stopIdle();\n\n  moveSlider(e.touches[0].clientX);\n\n  e.preventDefault();\n\n}, { passive: false });\n\n\nwrapper.addEventListener('touchmove', e => {\n\n  if (isDown) {\n    moveSlider(e.touches[0].clientX);\n  }\n\n  e.preventDefault();\n\n}, { passive: false });\n\n\nwrapper.addEventListener('touchend', () => {\n  isDown = false;\n});\n\n\n/* --- Occasional hint animation --- */\n\nfunction easeInOutSine(t) {\n  return -(Math.cos(Math.PI * t) - 1) / 2;\n}\n\n\nfunction animateHint() {\n\n  if (userInteracted) return;\n\n  const duration = 2000;\n  const start = 50;\n  const amplitude = 15;\n\n  let startTime = null;\n\n\n  function frame(time) {\n\n    if (!startTime) {\n      startTime = time;\n    }\n\n    const progress = (time - startTime) / duration;\n\n    const offset =\n      amplitude * Math.sin(progress * Math.PI * 2);\n\n    const percent = start + offset;\n\n    const rect = wrapper.getBoundingClientRect();\n\n    moveSlider(\n      rect.left + (rect.width * percent / 100)\n    );\n\n\n    if (progress < 1 && !userInteracted) {\n      requestAnimationFrame(frame);\n    }\n\n  }\n\n\n  requestAnimationFrame(frame);\n\n\n  const nextDelay =\n    2000 + Math.random() * 4000;\n\n\n  setTimeout(() => {\n\n    if (!userInteracted) {\n      animateHint();\n    }\n\n  }, nextDelay);\n\n}\n\n\nsetTimeout(animateHint, 2500);\n\n</script>",
