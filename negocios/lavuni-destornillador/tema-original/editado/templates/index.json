{
  "sections": {
    "custom_liquid_mAYDAJ": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"hero-banner-v3\">\n  <div class=\"overlay\"></div>\n\n  <div class=\"banner-container\">\n    <div class=\"col left\">\n      <h1 class=\"headline\">{{ 'lavuni_custom.text_4' | t }}<br>{{ 'lavuni_custom.text_5' | t }}</h1>\n    </div>\n\n    <div class=\"col center\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/S69f02346510d4f9591d8bd6f533c6a7e3.webp?v=1794747720\"\n        alt=\"{{ 'lavuni_custom.image_0' | t | escape }}\"\n        class=\"product\"\n      />\n    </div>\n\n    <div class=\"col right\">\n      <h2 class=\"subhead\">{{ 'lavuni_custom.text_6' | t }}<br>{{ 'lavuni_custom.text_7' | t }}<br>{{ 'lavuni_custom.text_8' | t }}</h2>\n    </div>\n  </div>\n\n  <div class=\"cta-card\">\n    <div class=\"cta-header\">\n      <div class=\"cta-icon\">✨</div>\n      <div class=\"cta-title\">{{ 'lavuni_custom.text_9' | t }}</div>\n    </div>\n\n    <p class=\"cta-desc\">\n      {{ 'lavuni_custom.text_10' | t }}\n    </p>\n\n    <div class=\"cta-actions\">\n      <a\n        href=\"{{ routes.root_url | append: '/products/destornillador-trinquete-24-en-1' | replace: '//', '/' }}\"\n        class=\"btn\"\n      >\n        {{ 'lavuni_custom.text_11' | t }}\n      </a>\n\n      <div class=\"rating-block\">\n        \n        <div class=\"score\">{{ 'lavuni_custom.text_12' | t }}</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.hero-banner-v3 {\n  position: relative;\n  overflow: hidden;\n  background-image: url('https://cdn.shopify.com/s/files/1/1065/4226/8680/files/Fondo_banner_blanco.jpg?v=1789578380');\n  background-size: cover;\n  background-position: center;\n  height: 560px;\n  min-height: 560px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n\n.overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    to bottom right,\n    rgba(15,15,30,0.02),\n    rgba(0,0,0,0.02)\n  );\n  z-index: 1;\n}\n\n.banner-container {\n  position: relative;\n  z-index: 2;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 220px minmax(0, 1fr);\n  align-items: center;\n  justify-items: center;\n  gap: 2rem;\n  width: calc(100% - 80px);\n  max-width: 1180px;\n  margin: 0 auto;\n  padding-bottom: 115px;\n  box-sizing: border-box;\n}\n\n/* MAIN HEADINGS */\n.hero-banner-v3 .headline,\n.hero-banner-v3 .subhead {\n  font-family: Georgia, 'Times New Roman', serif;\n  font-weight: 400;\n  color: #2E2A30;\n  text-shadow: none;\n  margin: 0;\n}\n\n.hero-banner-v3 .headline {\n  font-size: clamp(2.2rem, 3.5vw, 3.8rem);\n  line-height: 1.05;\n  text-align: left;\n}\n\n.hero-banner-v3 .subhead {\n  font-size: clamp(2rem, 3.2vw, 3.5rem);\n  line-height: 1.05;\n  text-align: right;\n}\n\n/* PRODUCT - OPTIMIZED FOR SHARPNESS */\n.hero-banner-v3 .product {\n  display: block;\n  width: auto;\n  height: auto;\n\n  max-width: 210px;\n  max-height: 390px;\n\n  object-fit: contain;\n\n  /* Keeps the PNG's natural rendering */\n  image-rendering: auto;\n\n  /* Helps prevent certain rendering artifacts */\n  backface-visibility: hidden;\n  -webkit-backface-visibility: hidden;\n\n  /* Shorter shadow to keep the product looking sharp */\n  filter: drop-shadow(\n    0 10px 14px rgba(0,0,0,0.18)\n  );\n\n  animation: flotar 6s ease-in-out infinite;\n}\n\n@keyframes flotar {\n  0%, 100% {\n    transform: translateY(-6px);\n  }\n\n  50% {\n    transform: translateY(6px);\n  }\n}\n\n/* CTA CARD */\n.cta-card {\n  position: absolute;\n  bottom: 25px;\n  left: 50%;\n  transform: translateX(-50%);\n\n  background: rgba(46, 42, 48, 0.82);\n\n  backdrop-filter: none;\n  -webkit-backdrop-filter: none;\n\n  border-radius: 18px;\n  padding: 1.25rem 1.8rem;\n\n  max-width: 650px;\n  width: calc(100% - 40px);\n\n  box-sizing: border-box;\n\n  color: #ffffff;\n\n  z-index: 3;\n\n  text-align: center;\n\n  box-shadow: 0 12px 35px rgba(0,0,0,0.22);\n\n  border: 1px solid rgba(255,255,255,0.22);\n}\n\n/* CARD HEADER */\n.cta-header {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n\n  gap: 0.5rem;\n\n  margin-bottom: 0.55rem;\n}\n\n.cta-icon {\n  font-size: 1.2rem;\n  line-height: 1;\n}\n\n.cta-title {\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-size: 1.25rem;\n\n  font-weight: 700;\n\n  line-height: 1.25;\n\n  color: #ffffff;\n\n  opacity: 1;\n}\n\n/* DESCRIPTION */\n.cta-desc {\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-size: 0.95rem;\n\n  font-weight: 400;\n\n  line-height: 1.45;\n\n  color: #ffffff;\n\n  opacity: 1;\n\n  margin: 0 0 0.9rem;\n}\n\n/* ACTIONS */\n.cta-actions {\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  gap: 2rem;\n\n  flex-wrap: nowrap;\n}\n\n/* BUTTON */\n.btn {\n  display: inline-block;\n\n  background: #2E2A30;\n\n  color: #ffffff;\n\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-weight: 600;\n\n  text-decoration: none;\n\n  padding: 1rem 2rem;\n\n  border-radius: 50px;\n\n  font-size: 0.95rem;\n\n  line-height: 1.2;\n\n  letter-spacing: 0.4px;\n\n  white-space: nowrap;\n\n  transition: all 0.3s ease;\n\n  box-shadow: 0 5px 15px rgba(0,0,0,0.25);\n}\n\n.btn:hover {\n  background: #2E2A30;\n\n  transform: translateY(-2px);\n\n  box-shadow: 0 8px 20px rgba(0,0,0,0.3);\n}\n\n/* RATINGS */\n.rating-block {\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: flex-start;\n\n  justify-content: center;\n\n  text-align: left;\n}\n\n.stars {\n  color: #FFD700;\n\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-size: 1.8rem;\n\n  font-weight: 400;\n\n  letter-spacing: 2px;\n\n  line-height: 1;\n\n  margin-bottom: 0.3rem;\n\n  white-space: nowrap;\n\n  opacity: 1;\n}\n\n.score {\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-size: 0.9rem;\n\n  font-weight: 500;\n\n  line-height: 1.3;\n\n  color: #ffffff;\n\n  opacity: 1;\n\n  white-space: nowrap;\n}\n\n/* TABLET */\n@media (max-width: 900px) {\n\n  .hero-banner-v3 {\n    height: 620px;\n    min-height: 620px;\n  }\n\n  .banner-container {\n    grid-template-columns: 1fr 170px 1fr;\n\n    width: calc(100% - 40px);\n\n    gap: 1rem;\n\n    padding-bottom: 150px;\n  }\n\n  .hero-banner-v3 .headline {\n    font-size: clamp(1.8rem, 4vw, 2.8rem);\n  }\n\n  .hero-banner-v3 .subhead {\n    font-size: clamp(1.7rem, 3.8vw, 2.6rem);\n  }\n\n  .hero-banner-v3 .product {\n    max-width: 165px;\n    max-height: 330px;\n\n    filter: drop-shadow(\n      0 8px 12px rgba(0,0,0,0.16)\n    );\n  }\n}\n\n/* MOBILE */\n@media (max-width: 650px) {\n\n  .hero-banner-v3 {\n    height: auto;\n\n    min-height: 760px;\n\n    padding: 45px 18px 25px;\n\n    box-sizing: border-box;\n\n    justify-content: flex-start;\n\n    background-position: center;\n  }\n\n  .banner-container {\n    grid-template-columns: 1fr;\n\n    width: 100%;\n\n    gap: 14px;\n\n    padding-bottom: 0;\n\n    margin: 0 auto;\n  }\n\n  .banner-container .left {\n    order: 1;\n  }\n\n  .banner-container .center {\n    order: 2;\n  }\n\n  .banner-container .right {\n    order: 3;\n  }\n\n  .hero-banner-v3 .headline,\n  .hero-banner-v3 .subhead {\n    text-align: center;\n  }\n\n  .hero-banner-v3 .headline {\n    font-size: 2.35rem;\n\n    line-height: 1.05;\n  }\n\n  .hero-banner-v3 .subhead {\n    font-size: 2rem;\n\n    line-height: 1.05;\n  }\n\n  .hero-banner-v3 .product {\n    max-width: 150px;\n\n    max-height: 260px;\n\n    filter: drop-shadow(\n      0 7px 10px rgba(0,0,0,0.15)\n    );\n  }\n\n  .cta-card {\n    position: relative;\n\n    left: auto;\n\n    bottom: auto;\n\n    transform: none;\n\n    width: 100%;\n\n    max-width: 520px;\n\n    margin: 22px auto 0;\n\n    padding: 1.1rem 1rem;\n  }\n\n  .cta-title {\n    font-size: 1.1rem;\n  }\n\n  .cta-desc {\n    font-size: 0.9rem;\n\n    line-height: 1.4;\n  }\n\n  .cta-actions {\n    flex-direction: column;\n\n    gap: 0.9rem;\n  }\n\n  .btn {\n    padding: 0.9rem 1.8rem;\n\n    font-size: 0.9rem;\n  }\n\n  .rating-block {\n    align-items: center;\n\n    text-align: center;\n  }\n\n  .stars {\n    font-size: 1.65rem;\n  }\n\n  .score {\n    font-size: 0.9rem;\n  }\n}\n</style>",
