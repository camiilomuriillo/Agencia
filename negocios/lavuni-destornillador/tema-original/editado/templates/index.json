    "custom_liquid_tPQHXL": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"benefits-section\">\n  <div class=\"benefits-header\">\n    <h2>{{ 'lavuni_custom.text_13' | t }}</h2>\n    <p>\n      {{ 'lavuni_custom.text_14' | t }}\n    </p>\n  </div>\n\n  <div class=\"benefits-grid\" id=\"benefitsGrid\">\n\n    <div class=\"benefit left\">\n\n      <div class=\"benefit-item\">\n        <div class=\"icon\">🔧</div>\n        <h3>{{ 'lavuni_custom.text_15' | t }}</h3>\n        <p class=\"detail\">\n          {{ 'lavuni_custom.text_16' | t }}\n        </p>\n      </div>\n\n      <div class=\"benefit-item\">\n        <div class=\"icon\">🧲</div>\n        <h3>{{ 'lavuni_custom.text_17' | t }}</h3>\n        <p class=\"detail\">\n          {{ 'lavuni_custom.text_18' | t }}\n        </p>\n      </div>\n\n    </div>\n\n    <div class=\"product-image\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/S2042435fc5014dbb88da38f6d114c082n.webp?v=1794747719\"\n        alt=\"{{ 'lavuni_custom.image_1' | t | escape }}\"\n      />\n    </div>\n\n    <div class=\"benefit right\">\n\n      <div class=\"benefit-item\">\n        <div class=\"icon\">🔩</div>\n        <h3>{{ 'lavuni_custom.text_19' | t }}</h3>\n        <p class=\"detail\">\n          {{ 'lavuni_custom.text_20' | t }}\n        </p>\n      </div>\n\n      <div class=\"benefit-item\">\n        <div class=\"icon\">🧰</div>\n        <h3>{{ 'lavuni_custom.text_21' | t }}</h3>\n        <p class=\"detail\">\n          {{ 'lavuni_custom.text_22' | t }}\n        </p>\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n<style>\n\n/* ===== Base layout ===== */\n\n.benefits-section {\n  text-align: center;\n  background: #fff;\n  padding: 6rem 2rem 0rem;\n  color: #2E2A39;\n  font-family: \"Poppins\", sans-serif;\n}\n\n\n/* ===== Header ===== */\n\n.benefits-header h2 {\n  font-size: 3rem;\n  font-weight: 700;\n  margin-bottom: 1rem;\n}\n\n.benefits-header p {\n  font-size: 1.15rem;\n  max-width: 820px;\n  margin: 0 auto 4rem;\n  color: #555;\n  line-height: 1.6;\n}\n\n\n/* ===== Main grid ===== */\n\n.benefits-grid {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  justify-items: center;\n  gap: 0;\n  position: relative;\n}\n\n\n/* ===== Center image ===== */\n\n.product-image img {\n  width: 600px;\n  max-width: 100%;\n  transition: transform 0.4s ease;\n  z-index: 2;\n}\n\n\n/* ===== Items ===== */\n\n.benefit {\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n}\n\n.benefit-item {\n  background: transparent;\n  padding: 1rem 1.2rem;\n  cursor: pointer;\n\n  transition:\n    transform 0.25s ease,\n    opacity 0.25s ease,\n    filter 0.25s ease;\n\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: flex-start;\n\n  text-align: center;\n\n  transform: scale(1.25);\n}\n\n\n/* ===== Icons ===== */\n\n.benefit-item .icon {\n  font-size: 2.5rem;\n  margin-bottom: 0.9rem;\n}\n\n\n/* ===== Titles ===== */\n\n.benefit-item h3 {\n  font-size: 1.55rem;\n  letter-spacing: 0.6px;\n  text-transform: uppercase;\n  text-align: center;\n  font-weight: 700;\n  margin: 0;\n}\n\n\n/* ===== Expandable text ===== */\n\n.benefit-item .detail {\n  margin-top: 0.6rem;\n\n  max-height: 0;\n  opacity: 0;\n  filter: blur(4px);\n  overflow: hidden;\n\n  transform: translateY(10px);\n\n  transition:\n    max-height 0.6s ease,\n    opacity 0.6s ease,\n    filter 0.6s ease,\n    transform 0.6s ease,\n    color 0.6s ease;\n\n  white-space: normal;\n  word-break: break-word;\n\n  max-width: 34ch;\n\n  margin-left: auto;\n  margin-right: auto;\n\n  text-align: center;\n\n  font-size: 1rem;\n  line-height: 1.55;\n\n  color: #444;\n}\n\n\n/* ===== Hover ===== */\n\n.benefit-item:hover .detail {\n  max-height: 200px;\n  opacity: 1;\n  filter: blur(0);\n  color: #E65286;\n  transform: translateY(0);\n}\n\n.benefit-item:hover {\n  transform: scale(1.4);\n}\n\n\n/* ===== Blur ===== */\n\n.benefits-grid:has(.benefit-item:hover)\n.benefit-item:not(:hover) {\n  filter: blur(3px);\n  opacity: 0.6;\n  transform: scale(1.4);\n}\n\n\n/* ===== Positioning ===== */\n\n.benefit.left {\n  transform: translateX(120px);\n}\n\n/* Slight adjustment to the right */\n.benefit.right {\n  transform: translateX(-90px);\n}\n\n\n/* ===== Responsive ===== */\n\n@media (max-width: 900px) {\n\n  .benefits-grid {\n    grid-template-columns: 1fr;\n    gap: 3rem;\n  }\n\n  .benefit {\n    flex-direction: row;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: 1rem;\n    transform: scale(0.7);\n  }\n\n  .product-image img {\n    width: 300px;\n  }\n\n  .benefit.left,\n  .benefit.right {\n    transform: none;\n  }\n\n  .benefit-item h3 {\n    font-size: 0.9rem;\n  }\n\n  .benefit-item .icon {\n    font-size: 1.8rem;\n  }\n\n  .benefit-item .detail {\n    font-size: 0.8rem;\n    line-height: 1.4;\n    max-width: 26ch;\n  }\n\n}\n\n</style>\n\n<script>\n\n(function(){\n\n  const grid = document.getElementById('benefitsGrid');\n\n  if (!grid) return;\n\n  const items = grid.querySelectorAll('.benefit-item');\n\n  const supportsHas =\n    CSS &&\n    CSS.supports &&\n    CSS.supports('selector(:has(*))');\n\n  if (supportsHas) return;\n\n  items.forEach(it => {\n\n    it.addEventListener('mouseenter', () => {\n      grid.classList.add('is-hovering');\n    });\n\n    it.addEventListener('mouseleave', () => {\n\n      const anyHover =\n        Array.from(items)\n        .some(el => el.matches(':hover'));\n\n      if (!anyHover) {\n        grid.classList.remove('is-hovering');\n      }\n\n    });\n\n  });\n\n})();\n\n</script>\n\n<style>\n\n/* ===== Fallback for browsers without :has() ===== */\n\n#benefitsGrid.is-hovering\n.benefit-item:not(:hover) {\n  filter: blur(3px);\n  opacity: 0.6;\n  transform: scale(0.98);\n}\n\n</style>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_Chjr8G": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"lavuni-offer-section\">\n\n  <!-- TITLE -->\n  <div class=\"lavuni-offer-title\">\n\n    <!-- CUSTOM SIREN -->\n    <svg class=\"lavuni-siren\" viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n      \n      <!-- Top rays -->\n      <path d=\"M32 7 V1\"\n            stroke=\"#292929\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"/>\n\n      <path d=\"M17 11 L13 6\"\n            stroke=\"#292929\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"/>\n\n      <path d=\"M47 11 L51 6\"\n            stroke=\"#292929\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"/>\n\n      <!-- Siren dome -->\n      <path d=\"M18 43\n               L21 24\n               C22 16 26 12 32 12\n               C38 12 42 16 43 24\n               L46 43\n               Z\"\n            fill=\"#E33C72\"/>\n\n      <!-- Highlight -->\n      <path d=\"M26 23\n               C27 19 29 17 32 17\"\n            fill=\"none\"\n            stroke=\"#FF9EBA\"\n            stroke-width=\"4\"\n            stroke-linecap=\"round\"/>\n\n      <!-- Bottom border -->\n      <rect x=\"15\" y=\"42\" width=\"34\" height=\"6\" rx=\"2\"\n            fill=\"#C23F79\"/>\n\n      <!-- Purple base -->\n      <path d=\"M12 49\n               Q12 46 16 46\n               H48\n               Q52 46 52 49\n               V54\n               H12\n               Z\"\n            fill=\"#9B68B7\"/>\n\n      <!-- Bottom line -->\n      <rect x=\"10\" y=\"54\" width=\"44\" height=\"4\" rx=\"2\"\n            fill=\"#76518E\"/>\n\n    </svg>\n\n    <span>{{ 'lavuni_custom.text_23' | t }}</span>\n\n  </div>\n\n\n  <!-- MAIN TEXT -->\n  <p class=\"lavuni-offer-description\">\n    {{ 'lavuni_custom.text_24' | t }} <strong>{{ 'lavuni_custom.text_25' | t }}</strong> {{ 'lavuni_custom.text_26' | t }}\n  </p>\n\n\n  <!-- BENEFIT -->\n  <p class=\"lavuni-offer-benefit\">\n    ✨ <em>{{ 'lavuni_custom.text_27' | t }}</em>\n  </p>\n\n\n  <!-- BUTTON -->\n  <a\n    href=\"{{ routes.root_url | append: '/products/destornillador-trinquete-24-en-1' | replace: '//', '/' }}\"\n    class=\"lavuni-buy-button\"\n  >\n    {{ 'lavuni_custom.text_11' | t }}\n  </a>\n\n</div>\n\n\n<style>\n\n.lavuni-offer-section {\n  width: 100%;\n  max-width: 1000px;\n  margin: 0 auto;\n  padding: 45px 20px 50px;\n  text-align: center;\n  box-sizing: border-box;\n}\n\n\n/* TITLE */\n\n.lavuni-offer-title {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 10px;\n\n  margin: 0 0 28px;\n\n  font-size: clamp(27px, 3vw, 42px);\n  font-weight: 800;\n  line-height: 1.15;\n\n  color: #222222;\n}\n\n\n/* PINK SIREN */\n\n.lavuni-siren {\n  width: 39px;\n  height: 39px;\n  flex-shrink: 0;\n  overflow: visible;\n}\n\n\n/* TEXT */\n\n.lavuni-offer-description {\n  margin: 0 auto 25px;\n\n  font-size: clamp(16px, 1.7vw, 21px);\n  line-height: 1.6;\n\n  color: #333333;\n  font-weight: 400;\n}\n\n.lavuni-offer-description strong {\n  font-weight: 800;\n}\n\n\n/* BENEFIT */\n\n.lavuni-offer-benefit {\n  margin: 0 auto 32px;\n\n  font-size: clamp(16px, 1.6vw, 20px);\n  line-height: 1.5;\n\n  color: #333333;\n}\n\n.lavuni-offer-benefit em {\n  font-style: italic;\n}\n\n\n/* BUTTON */\n\n.lavuni-buy-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  min-width: 290px;\n  padding: 18px 35px;\n\n  background: #1f222b;\n  color: #ffffff !important;\n\n  font-size: 17px;\n  font-weight: 700;\n  letter-spacing: 0.4px;\n\n  text-decoration: none !important;\n\n  border-radius: 10px;\n\n  box-shadow: 0 5px 15px rgba(0,0,0,0.12);\n\n  transition:\n    transform 0.2s ease,\n    box-shadow 0.2s ease,\n    background 0.2s ease;\n}\n\n\n.lavuni-buy-button:hover {\n  transform: translateY(-2px);\n  background: #11131a;\n  box-shadow: 0 8px 20px rgba(0,0,0,0.18);\n}\n\n\n.lavuni-buy-button:active {\n  transform: translateY(0);\n}\n\n\n/* MOBILE */\n\n@media screen and (max-width: 749px) {\n\n  .lavuni-offer-section {\n    padding: 32px 18px 38px;\n  }\n\n  .lavuni-offer-title {\n    gap: 7px;\n    margin-bottom: 20px;\n    font-size: 27px;\n  }\n\n  .lavuni-siren {\n    width: 31px;\n    height: 31px;\n  }\n\n  .lavuni-offer-description {\n    font-size: 16px;\n    line-height: 1.55;\n    margin-bottom: 20px;\n  }\n\n  .lavuni-offer-benefit {\n    font-size: 15px;\n    margin-bottom: 27px;\n  }\n\n  .lavuni-buy-button {\n    width: 100%;\n    max-width: 330px;\n    min-width: 0;\n\n    padding: 17px 25px;\n\n    font-size: 16px;\n  }\n\n}\n\n</style>",
