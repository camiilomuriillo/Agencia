    "custom_liquid_yDnaAD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"reviews-section\">\n  <h2 class=\"reviews-title\">\n    {{ 'lavuni_custom.text_28' | t }}\n  </h2>\n\n  <div class=\"reviews-slider\" id=\"reviewsSlider\">\n    <div class=\"reviews-fade fade-left\"></div>\n    <div class=\"reviews-fade fade-right\"></div>\n\n    <div class=\"reviews-track\" id=\"reviewsTrack\">\n\n      <!-- Reseña 1 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/review1.avif?v=1789597594\" alt=\"Kundrecension 1\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Fungerar jättebra på kluvna toppar.”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Fungerar jättebra på kluvna toppar.</p>\n        </div>\n      </div>\n\n      <!-- Reseña 2 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/Review2.avif?v=1789597614\" alt=\"Kundrecension 2\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Fungerar fantastiskt och kom fram i gott skick.”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Produkten kom fram i gott skick. Jag har bara använt den några gånger, men den fungerar fantastiskt. Kartongen var lite tillbucklad, men allt inuti var helt.</p>\n        </div>\n      </div>\n\n      <!-- Reseña 3 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/review3.avif?v=1789597639\" alt=\"Kundrecension 3\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Precis vad jag förväntade mig. Älskar den!”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Jag älskar den här produkten. Den är precis vad jag förväntade mig. Jag delade upp håret i sektioner och drog apparaten genom varje sektion ungefär tre gånger för att klippa bort skadade och kluvna toppar. Jag rekommenderar att platta håret först så att apparaten glider lättare. Jag använde också några droppar arganolja för att få den att glida smidigt. Jag är väldigt nöjd med mitt köp.</p>\n        </div>\n      </div>\n\n      <!-- Reseña 4 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/Review4.avif?v=1789597660\" alt=\"Kundrecension 4\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Mitt hår ser så fint ut. Älskar den!”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Jag älskar den! Den gör verkligen det den ska. Jag rekommenderar att använda den en gång i månaden. Håret ser jättefint ut efteråt, och jag älskar färgen 😍</p>\n        </div>\n      </div>\n\n      <!-- Reseña 5 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/review5.avif?v=1789597665\" alt=\"Kundrecension 5\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Kom fram i perfekt skick och fungerar jättebra.”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Produkten var mycket väl förpackad när den kom fram, hela vägen till Argentina, och fungerar perfekt. Den gör precis det den ska. Jag rekommenderar den.</p>\n        </div>\n      </div>\n\n      <!-- Reseña 6 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/review6.avif?v=1789597680\" alt=\"Kundrecension 6\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Fungerar utmärkt, precis som beskrivet.”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Den kom fram i utmärkt skick och fungerar fantastiskt. Den är precis som i beskrivningen. Laddningskabel och rengöringsborste ingår, liksom två hårklämmor som håller håret på plats under trimningen.</p>\n        </div>\n      </div>\n\n      <!-- Reseña 7 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/review7.avif?v=1789597696\" alt=\"Kundrecension 7\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Gör precis det den ska. Rekommenderas varmt!”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Jag är väldigt nöjd med produkten. Den gör precis det den ska. Jag rekommenderar den verkligen 👍</p>\n        </div>\n      </div>\n\n      <!-- Reseña 8 -->\n      <div class=\"review-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1065/4226/8680/files/review8.avif?v=1789597803\" alt=\"Kundrecension 8\">\n        <div class=\"review-overlay\">\n          <p class=\"short\">“Snabb leverans och fungerar riktigt bra.”</p>\n        </div>\n        <div class=\"review-full\">\n          <p>Den kom fram väldigt snabbt och fungerar bra. Jag har redan provat den och är nöjd. Jag valde den svarta och tycker verkligen om den.</p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<div class=\"reviews-cta\">\n  <div class=\"cta-actions\">\n    <div class=\"rating-block\">\n      <div class=\"score\">\n        {{ 'lavuni_custom.text_12' | t }}\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.reviews-section {\n  background: #ffffff;\n  padding: 3rem 0;\n  text-align: center;\n  position: relative;\n  overflow: hidden;\n}\n\n.reviews-title {\n  font-family: \"Poppins\", sans-serif;\n  font-weight: 700;\n  font-size: 2.4rem;\n  color: #2E2A39;\n  margin-bottom: 3rem;\n}\n\n.reviews-slider {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n}\n\n.reviews-track {\n  display: flex;\n  gap: 2rem;\n  will-change: transform;\n  transform: translateX(0);\n}\n\n.review-card {\n  position: relative;\n  flex: 0 0 320px;\n  border-radius: 16px;\n  overflow: hidden;\n  cursor: pointer;\n  transition: transform 0.3s ease;\n  aspect-ratio: 3 / 4;\n}\n\n.review-card img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  border-radius: 16px;\n  transition: transform 0.3s ease;\n}\n\n.review-card:hover img {\n  transform: scale(1.05);\n}\n\n.review-overlay {\n  position: absolute;\n  bottom: 0;\n  width: 100%;\n  padding: 1.4rem 1rem;\n  background: linear-gradient(\n    to top,\n    rgba(0,0,0,0.8),\n    rgba(0,0,0,0.1)\n  );\n  color: #fff;\n  text-align: left;\n  border-radius: 0 0 16px 16px;\n}\n\n.short {\n  font-size: 1.1rem;\n  font-weight: 500;\n}\n\n.review-full {\n  position: absolute;\n  bottom: -100%;\n  left: 0;\n  right: 0;\n  background: rgba(0,0,0,0.88);\n  color: #fff;\n  padding: 1.5rem;\n  transition: bottom 0.4s ease;\n  font-size: 1rem;\n  line-height: 1.5;\n  border-radius: 16px;\n}\n\n.review-card:hover .review-full {\n  bottom: 0;\n}\n\n.reviews-fade {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 140px;\n  z-index: 3;\n  pointer-events: none;\n}\n\n.fade-left {\n  left: 0;\n  background: linear-gradient(\n    to right,\n    #f7d7dc 40%,\n    transparent\n  );\n}\n\n.fade-right {\n  right: 0;\n  background: linear-gradient(\n    to left,\n    #f7d7dc 40%,\n    transparent\n  );\n}\n\n.reviews-cta {\n  background: #fff;\n  text-align: center;\n  padding: 2rem 1rem 5rem;\n  margin-top: -0.5rem;\n}\n\n.reviews-cta .cta-actions {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4rem;\n  flex-wrap: wrap;\n}\n\n.reviews-cta .rating-block {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n}\n\n.reviews-cta .score {\n  font-size: 1.05rem;\n  color: #2E2A39;\n  opacity: 0.9;\n  font-weight: 500;\n}\n\n@media (max-width: 900px) {\n  .review-card {\n    flex: 0 0 80vw;\n  }\n\n  .reviews-fade {\n    width: 80px;\n  }\n\n  .reviews-cta {\n    padding: 1.5rem 1rem 4.5rem;\n  }\n\n  .reviews-cta .cta-actions {\n    flex-direction: column;\n    gap: 2rem;\n  }\n\n  .reviews-cta .score {\n    font-size: 1rem;\n    text-align: center;\n  }\n\n  .reviews-cta .rating-block {\n    align-items: center;\n    text-align: center;\n  }\n}\n</style>\n\n<script>\n(function () {\n  const slider = document.getElementById('reviewsSlider');\n  const track = document.getElementById('reviewsTrack');\n\n  if (!slider || !track) return;\n\n  if (!track.dataset.duped) {\n    track.innerHTML += track.innerHTML;\n    track.dataset.duped = '1';\n  }\n\n  let pos = 0;\n  let speed = 40;\n  let last = performance.now();\n  let paused = false;\n  let halfWidth = 0;\n\n  const setPaused = (value) => {\n    paused = value;\n  };\n\n  slider.addEventListener('mouseenter', () => setPaused(true));\n  slider.addEventListener('mouseleave', () => setPaused(false));\n\n  slider.addEventListener(\n    'touchstart',\n    () => setPaused(true),\n    { passive: true }\n  );\n\n  slider.addEventListener(\n    'touchend',\n    () => setPaused(false)\n  );\n\n  document.addEventListener('visibilitychange', () => {\n    last = performance.now();\n  });\n\n  function measure() {\n    halfWidth = track.scrollWidth / 2;\n  }\n\n  const imgs = track.querySelectorAll('img');\n  let pending = imgs.length;\n\n  if (pending === 0) {\n    measure();\n  } else {\n    imgs.forEach(img => {\n      if (img.complete) {\n        if (--pending === 0) measure();\n      } else {\n        img.addEventListener('load', () => {\n          if (--pending === 0) measure();\n        }, { once: true });\n\n        img.addEventListener('error', () => {\n          if (--pending === 0) measure();\n        }, { once: true });\n      }\n    });\n  }\n\n  window.addEventListener('resize', measure);\n\n  function loop(now) {\n    const dt = (now - last) / 1000;\n    last = now;\n\n    if (!paused && halfWidth > 0) {\n      pos -= speed * dt;\n\n      if (-pos >= halfWidth) {\n        pos += halfWidth;\n      }\n\n      track.style.transform = `translateX(${pos}px)`;\n    }\n\n    requestAnimationFrame(loop);\n  }\n\n  requestAnimationFrame(loop);\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      },
      "disabled": true
    },
