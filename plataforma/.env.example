# ─── Marca ───────────────────────────────────────────────
BRAND_NAME=Estudio IA
# BRAND_TAGLINE=Movimientos de cámara de cine, personajes consistentes y voces naturales.

# ─── IA: clave de fal.ai (https://fal.ai/dashboard/keys) ─
# Vacía = MODO DEMO: genera resultados de prueba sin gastar dinero.
FAL_KEY=

# ─── Pagos: Stripe (https://dashboard.stripe.com/apikeys) ─
# Usa primero las claves de prueba (sk_test_...). Vacía = compras simuladas (solo en modo demo).
STRIPE_SECRET_KEY=
# Secreto del webhook (whsec_...). Endpoint: https://TU-DOMINIO/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur

# ─── Servidor ────────────────────────────────────────────
PORT=3000
# URL pública (para volver de Stripe). Ej.: https://estudio.tudominio.com
PUBLIC_URL=
# Créditos gratis para cada usuario nuevo
FREE_CREDITS=20
# Carpeta de datos (base de datos + archivos generados). Por defecto ./data
# DATA_DIR=/data
